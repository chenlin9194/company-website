---
import Layout from '../layouts/Layout.astro';
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'zh' ? '' : '/en';
const rfqItems = t.raw('products.rfq.items') as string[];
const processSteps = t.raw('products.process.steps') as Array<{ step: string; title: string; desc: string }>;
---

<Layout locale={locale} title={t.t('products.title')}>
  <section class="page-hero">
    <div class="page-shell page-hero-grid"><div><p class="eyebrow eyebrow-light">{t.t('products.eyebrow')}</p><h1>{t.t('products.title')}</h1><p>{t.t('products.subtitle')}</p></div><div class="page-hero-mark" aria-hidden="true">01<br /><span>RFQ → quote</span></div></div>
  </section>

  <section class="section section-paper">
    <div class="page-shell">
      <div class="section-heading"><p class="eyebrow">{t.t('products.process.eyebrow')}</p><h2>{t.t('products.process.title')}</h2><p>{t.t('products.process.intro')}</p></div>
      <div class="process-rail process-rail-large">
        {processSteps.map((step, index) => (
          <article class="process-step"><div class="process-top"><span>{step.step}</span>{index < processSteps.length - 1 && <i aria-hidden="true"></i>}</div><h3>{step.title}</h3><p>{step.desc}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sand">
    <div class="page-shell requirements-grid">
      <div class="section-heading"><p class="eyebrow">{t.t('products.rfq.eyebrow')}</p><h2>{t.t('products.rfq.title')}</h2><p>{t.t('products.rfq.desc')}</p><a href={`${prefix}/contact`} class="button button-dark">{t.t('nav.contact')}<span aria-hidden="true">→</span></a></div>
      <div class="requirements-list">{rfqItems.map((item, index) => <div class="requirement-item"><span>0{index + 1}</span><p>{item}</p></div>)}</div>
    </div>
  </section>

  <section class="section section-paper"><div class="page-shell notice-panel"><span class="notice-icon" aria-hidden="true">i</span><p>{t.t('products.notice')}</p></div></section>
</Layout>
