---
import Layout from '../layouts/Layout.astro';
import ProductCard from './ProductCard.astro';
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const allCategories = t.raw('products.categories') as Array<{
  id: string; group: string; name: string; desc: string; specs?: string[]; applications?: string[];
}>;

const groupLabels = t.raw('products.groupLabels') as Record<string, string>;

// Group categories by their group field
const groupMap = new Map<string, typeof allCategories>();
let groupOrder: string[] = [];
allCategories.forEach(cat => {
  if (!groupMap.has(cat.group)) {
    groupMap.set(cat.group, []);
    groupOrder.push(cat.group);
  }
  groupMap.get(cat.group)!.push(cat);
});

const processSteps = t.raw('products.process.steps') as Array<{ step: string; title: string; desc: string }>;

const productImages: Record<string, string> = {
  springs: '/images/product-springs.jpg',
  stamping: '/images/product-stamping.jpg',
  mim: '/images/product-mim.jpg',
  cnc: '/images/product-cnc.jpg',
  'fiber-singlemode': '/images/product-fiber.svg',
  'fiber-multimode': '/images/product-fiber.svg',
  cable: '/images/product-cable.svg',
};
---

<Layout locale={locale} title={t.t('products.title')}>
  <!-- Page Header -->
  <section class="bg-gradient-to-br from-primary-500 to-primary-700 text-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">{t.t('products.title')}</h1>
      <p class="text-gray-200 text-lg">{t.t('products.subtitle')}</p>
    </div>
  </section>

  <!-- Product Categories by Group -->
  {groupOrder.map((groupKey) => (
    <section class={groupKey === groupOrder[0] ? 'bg-gray-50' : 'bg-white'}>
      <div class="container-section">
        {groupLabels[groupKey] && (
          <div class="mb-8">
            <h2 class="section-title">{groupLabels[groupKey]}</h2>
            <div class="w-16 h-1 bg-accent-500 mx-auto mt-2"></div>
          </div>
        )}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {groupMap.get(groupKey)!.map((cat) => (
            <ProductCard
              name={cat.name}
              description={cat.desc}
              specs={cat.specs}
              applications={cat.applications}
              image={productImages[cat.id]}
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Process Flow -->
  <section class="bg-white">
    <div class="container-section">
      <h2 class="section-title">{t.t('products.process.title')}</h2>
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
          {processSteps.map((step) => (
            <div class="text-center relative">
              <div class="w-16 h-16 bg-primary-500 text-white rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold shadow-md">
                {step.step}
              </div>
              <h3 class="font-semibold text-primary-500 mb-2">{step.title}</h3>
              <p class="text-sm text-gray-500">{step.desc}</p>
              {step.step !== '05' && (
                <div class="hidden md:block absolute top-8 -right-3 text-accent-400 text-2xl">→</div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
