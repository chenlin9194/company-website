---
export interface Props {
  name: string;
  description: string;
  specs?: string[];
  applications?: string[];
  index: number;
}

const { name, description, specs, applications, index } = Astro.props;
---

<div class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 group">
  <!-- Image placeholder -->
  <div class="h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center relative overflow-hidden">
    <div class="text-6xl font-bold text-gray-300 group-hover:scale-110 transition-transform duration-300">
      {String(index + 1).padStart(2, '0')}
    </div>
  </div>
  <div class="p-6">
    <h3 class="text-xl font-bold text-primary-500 mb-3">{name}</h3>
    <p class="text-gray-600 text-sm leading-relaxed mb-4">{description}</p>

    {specs && specs.length > 0 && (
      <div class="mb-4">
        <h4 class="text-sm font-semibold text-gray-700 mb-2">Specifications</h4>
        <ul class="space-y-1">
          {specs.map((spec) => (
            <li class="text-sm text-gray-500 flex items-start">
              <span class="text-accent-500 mr-2">•</span>
              {spec}
            </li>
          ))}
        </ul>
      </div>
    )}

    {applications && applications.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {applications.map((app) => (
          <span class="bg-primary-50 text-primary-600 text-xs px-3 py-1 rounded-full font-medium">
            {app}
          </span>
        ))}
      </div>
    )}
  </div>
</div>
