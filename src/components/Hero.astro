---
export interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaLink: string;
  cta2Text?: string;
  cta2Link?: string;
  bgImage?: string;
}

const { title, subtitle, ctaText, ctaLink, cta2Text, cta2Link, bgImage } = Astro.props;
---

<section class="relative bg-gradient-to-br from-primary-500 via-primary-600 to-primary-700 text-white overflow-hidden">
  {bgImage && (
    <div class="absolute inset-0">
      <img src={bgImage} alt="" class="w-full h-full object-cover opacity-20" />
    </div>
  )}
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-10 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-accent-400 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-32">
    <div class="max-w-3xl">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-gray-200 mb-10 leading-relaxed">
        {subtitle}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href={ctaLink} class="btn-primary text-lg">{ctaText}</a>
        {cta2Text && cta2Link && (
          <a href={cta2Link} class="inline-block bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3 rounded-lg backdrop-blur-sm transition-colors duration-200 text-lg">
            {cta2Text}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
