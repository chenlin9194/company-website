---
export interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaText: string;
  ctaLink: string;
  secondaryText: string;
  secondaryLink: string;
  focusLabel: string;
  focusText: string;
}

const { eyebrow, title, subtitle, ctaText, ctaLink, secondaryText, secondaryLink, focusLabel, focusText } = Astro.props;
---

<section class="hero-shell">
  <div class="hero-grid page-shell">
    <div class="hero-copy">
      <p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span>{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-lede">{subtitle}</p>
      <div class="hero-actions">
        <a href={ctaLink} class="button button-accent">{ctaText}<span aria-hidden="true">→</span></a>
        <a href={secondaryLink} class="button button-ghost">{secondaryText}</a>
      </div>
      <div class="hero-focus">
        <span class="hero-focus-label">{focusLabel}</span>
        <span>{focusText}</span>
      </div>
    </div>

    <div class="hero-visual" aria-label="Abstract cable and sourcing workflow graphic" role="img">
      <div class="visual-grid"></div>
      <div class="visual-panel">
        <span class="visual-kicker">RFQ → verified scope</span>
        <div class="cable-diagram" aria-hidden="true">
          <span class="cable-ring ring-outer"></span>
          <span class="cable-ring ring-mid"></span>
          <span class="cable-core"></span>
          <span class="cable-strand strand-a"></span>
          <span class="cable-strand strand-b"></span>
          <span class="cable-strand strand-c"></span>
        </div>
        <div class="visual-caption"><span>01</span><span>clarify the request</span></div>
        <div class="visual-caption"><span>02</span><span>check suitable supply</span></div>
        <div class="visual-caption"><span>03</span><span>confirm quote assumptions</span></div>
      </div>
    </div>
  </div>
</section>
