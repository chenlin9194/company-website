---
import Layout from '../layouts/Layout.astro';
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const values = t.raw('about.values.items') as Array<{ title: string; desc: string }>;
---

<Layout locale={locale} title={t.t('about.title')}>
  <section class="page-hero page-hero-quiet"><div class="page-shell page-hero-grid"><div><p class="eyebrow eyebrow-light">{t.t('about.eyebrow')}</p><h1>{t.t('about.title')}</h1><p>{t.t('about.subtitle')}</p></div><div class="page-hero-mark page-hero-mark-quiet" aria-hidden="true"><span>TRADING / SOURCING</span></div></div></section>

  <section class="section section-paper"><div class="page-shell about-layout"><div class="section-heading"><p class="eyebrow">{t.t('about.intro.eyebrow')}</p><h2>{t.t('about.intro.title')}</h2></div><div class="about-copy"><p class="large-copy">{t.t('about.intro.p1')}</p><p>{t.t('about.intro.p2')}</p><p>{t.t('about.intro.p3')}</p></div></div></section>

  <section class="section section-ink"><div class="page-shell"><div class="section-heading heading-light"><p class="eyebrow eyebrow-light">{t.t('about.values.eyebrow')}</p><h2>{t.t('about.values.title')}</h2><p>{t.t('about.values.intro')}</p></div><div class="values-list">{values.map((value, index) => <article class="value-row"><span>0{index + 1}</span><div><h3>{value.title}</h3><p>{value.desc}</p></div></article>)}</div></div></section>

  <section class="section section-sand"><div class="page-shell boundary-panel"><div><p class="eyebrow">{t.t('about.boundary.eyebrow')}</p><h2>{t.t('about.boundary.title')}</h2></div><p>{t.t('about.boundary.desc')}</p></div></section>
</Layout>
