---
import Layout from '../layouts/Layout.astro';
import ContactForm from './ContactForm.astro';
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout locale={locale} title={t.t('contact.title')}>
  <section class="page-hero page-hero-contact"><div class="page-shell page-hero-grid"><div><p class="eyebrow eyebrow-light">{t.t('contact.eyebrow')}</p><h1>{t.t('contact.title')}</h1><p>{t.t('contact.subtitle')}</p></div><div class="page-hero-mark" aria-hidden="true">RFQ<span>01 / START HERE</span></div></div></section>
  <section class="section section-paper"><div class="page-shell contact-layout"><div class="contact-intro"><p class="eyebrow">{t.t('contact.intro.eyebrow')}</p><h2>{t.t('contact.intro.title')}</h2><p>{t.t('contact.intro.desc')}</p><div class="contact-checklist">{(t.raw('contact.intro.items') as string[]).map((item, index) => <div><span>0{index + 1}</span><p>{item}</p></div>)}</div></div><ContactForm locale={locale} /></div></section>
</Layout>
