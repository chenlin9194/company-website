---
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'zh' ? '' : '/en';

const features = t.raw('home.features.items') as Array<{ title: string; desc: string }>;
---

<Layout locale={locale}>
  <Hero
    title={t.t('home.hero.title')}
    subtitle={t.t('home.hero.subtitle')}
    ctaText={t.t('home.hero.cta')}
    ctaLink={`${prefix}/contact`}
    cta2Text={t.t('home.hero.cta2')}
    cta2Link={`${prefix}/about`}
  />

  <!-- Features -->
  <section class="bg-gray-50">
    <div class="container-section">
      <h2 class="section-title">{t.t('home.features.title')}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map((feature) => (
          <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow text-center">
            <div class="w-14 h-14 bg-primary-50 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-800 mb-2">{feature.title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="bg-white">
    <div class="container-section">
      <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-primary-500 mb-6">{t.t('home.about.title')}</h2>
          <p class="text-gray-600 leading-relaxed mb-6">{t.t('home.about.desc')}</p>
          <a href={`${prefix}/about`} class="btn-primary">{t.t('home.about.cta')}</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-primary-600 to-primary-700">
    <div class="container-section text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{t.t('home.cta.title')}</h2>
      <p class="text-gray-200 text-lg mb-8 max-w-2xl mx-auto">{t.t('home.cta.desc')}</p>
      <a href={`${prefix}/contact`} class="inline-block bg-accent-500 hover:bg-accent-600 text-white font-semibold px-10 py-4 rounded-lg text-lg transition-colors duration-200">
        {t.t('home.cta.button')}
      </a>
    </div>
  </section>
</Layout>
