---
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'zh' ? '' : '/en';
const audiences = t.raw('home.audiences.items') as Array<{ title: string; desc: string }>;
const focusAreas = t.raw('home.focus.items') as Array<{ number: string; title: string; desc: string }>;
const principles = t.raw('home.principles.items') as Array<{ title: string; desc: string }>;
const processSteps = t.raw('home.process.steps') as Array<{ number: string; title: string; desc: string }>;
---

<Layout locale={locale}>
  <Hero
    eyebrow={t.t('home.hero.eyebrow')}
    title={t.t('home.hero.title')}
    subtitle={t.t('home.hero.subtitle')}
    ctaText={t.t('home.hero.cta')}
    ctaLink={`${prefix}/contact`}
    secondaryText={t.t('home.hero.secondary')}
    secondaryLink={`${prefix}/products`}
    focusLabel={t.t('home.hero.focusLabel')}
    focusText={t.t('home.hero.focusText')}
  />

  <section class="section section-paper" id="who-we-help">
    <div class="page-shell">
      <div class="section-heading heading-split">
        <div><p class="eyebrow">{t.t('home.audiences.eyebrow')}</p><h2>{t.t('home.audiences.title')}</h2></div>
        <p>{t.t('home.audiences.intro')}</p>
      </div>
      <div class="audience-grid">
        {audiences.map((audience, index) => (
          <article class="audience-card">
            <span class="card-index">0{index + 1}</span>
            <h3>{audience.title}</h3>
            <p>{audience.desc}</p>
            <span class="card-arrow" aria-hidden="true">↗</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-ink" id="focus">
    <div class="page-shell">
      <div class="section-heading heading-light heading-split">
        <div><p class="eyebrow eyebrow-light">{t.t('home.focus.eyebrow')}</p><h2>{t.t('home.focus.title')}</h2></div>
        <p>{t.t('home.focus.intro')}</p>
      </div>
      <div class="focus-grid">
        {focusAreas.map((focus) => (
          <article class="focus-card">
            <span class="focus-number">{focus.number}</span>
            <h3>{focus.title}</h3>
            <p>{focus.desc}</p>
            <span class="focus-rule"></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-paper" id="process">
    <div class="page-shell">
      <div class="section-heading">
        <p class="eyebrow">{t.t('home.process.eyebrow')}</p>
        <h2>{t.t('home.process.title')}</h2>
        <p>{t.t('home.process.intro')}</p>
      </div>
      <div class="process-rail">
        {processSteps.map((step, index) => (
          <article class="process-step">
            <div class="process-top"><span>{step.number}</span>{index < processSteps.length - 1 && <i aria-hidden="true"></i>}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sand" id="why-ningxin">
    <div class="page-shell why-grid">
      <div class="section-heading"><p class="eyebrow">{t.t('home.principles.eyebrow')}</p><h2>{t.t('home.principles.title')}</h2><p>{t.t('home.principles.intro')}</p></div>
      <div class="principle-list">
        {principles.map((principle, index) => (
          <article class="principle-row"><span>0{index + 1}</span><div><h3>{principle.title}</h3><p>{principle.desc}</p></div></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-paper about-teaser">
    <div class="page-shell about-teaser-grid">
      <div class="about-marker" aria-hidden="true"><span>NINGXIN</span><small>TRADING / SOURCING</small></div>
      <div><p class="eyebrow">{t.t('home.about.eyebrow')}</p><h2>{t.t('home.about.title')}</h2><p class="large-copy">{t.t('home.about.desc')}</p><a href={`${prefix}/about`} class="text-link">{t.t('home.about.cta')} <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section section-cta">
    <div class="page-shell cta-panel"><div><p class="eyebrow eyebrow-light">{t.t('home.cta.eyebrow')}</p><h2>{t.t('home.cta.title')}</h2><p>{t.t('home.cta.desc')}</p></div><a href={`${prefix}/contact`} class="button button-accent">{t.t('home.cta.button')}<span aria-hidden="true">→</span></a></div>
  </section>
</Layout>
