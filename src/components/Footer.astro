---
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'zh' ? '' : '/en';
---

<footer class="site-footer">
  <div class="page-shell footer-grid">
    <div class="footer-intro">
      <a href={prefix || '/'} class="brand brand-footer">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="brand-name">{t.t('site.title')}</span>
      </a>
      <p>{t.t('site.description')}</p>
    </div>
    <div>
      <p class="footer-label">{t.t('footer.explore')}</p>
      <div class="footer-links">
        <a href={prefix || '/'}>{t.t('nav.home')}</a>
        <a href={`${prefix}/about`}>{t.t('nav.about')}</a>
        <a href={`${prefix}/products`}>{t.t('nav.products')}</a>
      </div>
    </div>
    <div class="footer-rfq">
      <p class="footer-label">{t.t('footer.nextStep')}</p>
      <p>{t.t('footer.contactCta')}</p>
      <a href={`${prefix}/contact`} class="text-link">{t.t('nav.contact')} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="page-shell footer-bottom"><span>{t.t('footer.copyright')}</span><span>{t.t('footer.note')}</span></div>
</footer>
