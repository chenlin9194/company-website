---
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const prefix = locale === 'zh' ? '' : '/en';
---

<footer class="bg-primary-500 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Company Info -->
      <div>
        <div class="flex items-center space-x-2 mb-4">
          <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
            <span class="text-primary-500 font-bold text-lg">N</span>
          </div>
          <span class="text-xl font-bold">{t.t('site.company')}</span>
        </div>
        <p class="text-gray-300 text-sm leading-relaxed">
          {t.t('site.description')}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4">{t.t('footer.quickLinks')}</h3>
        <ul class="space-y-2">
          <li><a href={prefix || '/'} class="text-gray-300 hover:text-white transition-colors text-sm">{t.t('nav.home')}</a></li>
          <li><a href={`${prefix}/about`} class="text-gray-300 hover:text-white transition-colors text-sm">{t.t('nav.about')}</a></li>
          <li><a href={`${prefix}/products`} class="text-gray-300 hover:text-white transition-colors text-sm">{t.t('nav.products')}</a></li>
          <li><a href={`${prefix}/contact`} class="text-gray-300 hover:text-white transition-colors text-sm">{t.t('nav.contact')}</a></li>
        </ul>
      </div>

      <!-- RFQ -->
      <div>
        <h3 class="text-lg font-semibold mb-4">{t.t('footer.contactInfo')}</h3>
        <a href={`${prefix}/contact`} class="inline-block text-gray-300 hover:text-white transition-colors text-sm underline">
          {t.t('footer.contactCta')}
        </a>
      </div>
    </div>
  </div>

  <div class="border-t border-primary-400/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <p class="text-center text-gray-400 text-sm">{t.t('footer.copyright')}</p>
    </div>
  </div>
</footer>
