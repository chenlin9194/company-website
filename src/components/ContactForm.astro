---
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="rfq-form-card">
  <div class="form-card-head"><span class="form-card-kicker">{t.t('contact.form.kicker')}</span><h2>{t.t('contact.form.title')}</h2></div>
  <form
    id="contact-form"
    name="contact"
    method="POST"
    action="/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    data-success-text={t.t('contact.form.success')}
    data-error-text={t.t('contact.form.error')}
    data-sending-text={t.t('contact.form.sending')}
    class="rfq-form"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="hidden"><label>Do not fill this out: <input name="bot-field" /></label></p>
    <div class="form-grid">
      <label><span>{t.t('contact.form.name')}</span><input type="text" name="name" required autocomplete="name" placeholder={locale === 'zh' ? '您的姓名' : 'Your name'} /></label>
      <label><span>{t.t('contact.form.email')}</span><input type="email" name="email" required autocomplete="email" placeholder={locale === 'zh' ? '您的邮箱' : 'you@company.com'} /></label>
      <label><span>{t.t('contact.form.company')}</span><input type="text" name="company" autocomplete="organization" placeholder={locale === 'zh' ? '公司名称（可选）' : 'Company (optional)'} /></label>
      <label><span>{t.t('contact.form.phone')}</span><input type="tel" name="phone" autocomplete="tel" placeholder={locale === 'zh' ? '电话（可选）' : 'Phone (optional)'} /></label>
    </div>
    <label><span>{t.t('contact.form.message')}</span><textarea name="message" rows="7" required placeholder={locale === 'zh' ? '产品说明、规格、数量、目的地和文件要求' : 'Product description, specification, quantity, destination and document requirements'}></textarea></label>
    <p class="form-note">{t.t('contact.form.note')}</p>
    <button type="submit" class="button button-dark button-submit">{t.t('contact.form.submit')}<span aria-hidden="true">→</span></button>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.sendingText || 'Sending...';
      try {
        const formData = new FormData(form);
        const response = await fetch(form.action || '/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData as any).toString(),
        });
        if (response.ok) {
          form.innerHTML = `<div class="form-success"><span aria-hidden="true">✓</span><p>${form.dataset.successText || 'Thank you. Your inquiry was submitted.'}</p></div>`;
        } else {
          throw new Error(`Form submission failed with HTTP ${response.status}.`);
        }
      } catch (error) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        alert(form.dataset.errorText || 'The inquiry could not be submitted. Please try again later.');
      }
    });
  }
</script>
