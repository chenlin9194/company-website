---
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="bg-white rounded-xl shadow-md p-6 md:p-8">
  <h3 class="text-2xl font-bold text-primary-500 mb-6">{t.t('contact.form.title')}</h3>
  <form
    id="contact-form"
    name="contact"
    method="POST"
    action="/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    data-success-text={t.t('contact.form.success')}
    data-error-text={t.t('contact.form.error')}
    data-sending-text={t.t('contact.form.sending')}
    class="space-y-5"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="hidden">
      <label>Do not fill this out: <input name="bot-field" /></label>
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">{t.t('contact.form.name')}</label>
        <input type="text" name="name" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors"
          placeholder={locale === 'zh' ? '请输入姓名' : 'Your name'} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">{t.t('contact.form.email')}</label>
        <input type="email" name="email" required
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors"
          placeholder={locale === 'zh' ? '请输入邮箱' : 'Your email'} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">{t.t('contact.form.phone')}</label>
        <input type="tel" name="phone"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors"
          placeholder={locale === 'zh' ? '请输入电话' : 'Your phone'} />
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">{t.t('contact.form.company')}</label>
        <input type="text" name="company"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors"
          placeholder={locale === 'zh' ? '请输入公司名称' : 'Your company'} />
      </div>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">{t.t('contact.form.message')}</label>
      <textarea name="message" rows="5" required
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors resize-none"
        placeholder={locale === 'zh' ? '请描述您的需求，包括产品类型、规格、数量等...' : 'Describe your requirements, including product type, specifications, quantity...'}></textarea>
    </div>
    <button type="submit"
      class="btn-primary w-full text-center text-lg">
      {t.t('contact.form.submit')}
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.sendingText || 'Sending...';

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action || '/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(formData as any).toString(),
        });
        if (response.ok) {
          form.innerHTML = `<div class="text-center py-12"><div class="text-5xl mb-4">✓</div><p class="text-xl text-gray-700 font-medium">${form.dataset.successText || 'Thank you. Your inquiry was submitted.'}</p></div>`;
        } else {
          throw new Error(`Form submission failed with HTTP ${response.status}.`);
        }
      } catch (error) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
        alert(form.dataset.errorText || 'The inquiry could not be submitted. Please try again later.');
      }
    });
  }
</script>
