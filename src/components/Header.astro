---
import { useTranslations, type Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
const prefix = locale === 'zh' ? '' : '/en';
let pathSuffix = currentPath.startsWith('/en') ? currentPath.replace('/en', '') || '/' : currentPath;
if (pathSuffix === '') pathSuffix = '/';
const langSwitchPath = locale === 'zh' ? `/en${pathSuffix}` : pathSuffix;
const isHome = currentPath === '/' || currentPath === '/en' || currentPath === '/en/';
const isAbout = currentPath.startsWith('/about') || currentPath.startsWith('/en/about');
const isProducts = currentPath.startsWith('/products') || currentPath.startsWith('/en/products');
const navItems = [
  { href: prefix || '/', label: t.t('nav.home'), active: isHome },
  { href: `${prefix}/about`, label: t.t('nav.about'), active: isAbout },
  { href: `${prefix}/products`, label: t.t('nav.products'), active: isProducts },
];
---

{locale === 'zh' && (
  <div class="route-notice"><div class="page-shell"><span>{t.t('nav.buyerRoute')}</span><a href="/en/">English buyer route <span aria-hidden="true">→</span></a></div></div>
)}
<header class="site-header">
  <nav class="page-shell nav-shell" aria-label={t.t('nav.mainLabel')}>
    <a href={prefix || '/'} class="brand" aria-label={t.t('site.title')}>
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="brand-name">{t.t('site.title')}</span>
    </a>
    <div class="desktop-nav">
      {navItems.map((item) => (
        <a href={item.href} class:list={["nav-link", { active: item.active }]} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={`${prefix}/contact`} class="nav-cta">{t.t('nav.contact')}<span aria-hidden="true">→</span></a>
      <a href={langSwitchPath} class="language-link" aria-label={locale === 'zh' ? 'Switch to English' : '切换中文'}>{locale === 'zh' ? 'EN' : '中文'}</a>
    </div>
    <div class="mobile-nav-actions">
      <a href={langSwitchPath} class="language-link" aria-label={locale === 'zh' ? 'Switch to English' : '切换中文'}>{locale === 'zh' ? 'EN' : '中文'}</a>
      <button id="menu-btn" class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.t('nav.menu')}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="mobile-menu page-shell" hidden>
    {navItems.map((item) => (
      <a href={item.href} class="mobile-link" aria-current={item.active ? 'page' : undefined}>{item.label}</a>
    ))}
    <a href={`${prefix}/contact`} class="mobile-link mobile-link-cta">{t.t('nav.contact')}<span aria-hidden="true">→</span></a>
  </div>
</header>

<script>
  const menuButton = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  menuButton?.addEventListener('click', () => {
    if (!menu || !menuButton) return;
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    menu.hidden = open;
  });
</script>
