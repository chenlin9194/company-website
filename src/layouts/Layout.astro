---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, getLocaleFromUrl } from '../i18n';

export interface Props {
  title?: string;
  description?: string;
  locale?: string;
}

const { title, description } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const prefix = locale === 'zh' ? '' : '/en';
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || t.t('site.description')} />
    <title>{title ? `${title} | ${t.t('site.title')}` : t.t('site.title')}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header locale={locale} />
    <a class="mobile-rfq-bar" href={`${prefix}/contact`}>
      <span>{t.t('nav.contact')}</span><span aria-hidden="true">→</span>
    </a>
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
